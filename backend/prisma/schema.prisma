generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER       
  ADMIN     
  MANAGER    
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}



model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String?
  email     String    @unique
  password  String?   
  image     String?   
  role      Role      @default(USER)
  phone     String?  
  provider  String?   
  emailVerified Boolean   @default(false)
  googleId  String?  

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  orders    Order[]     
  addresses Address[]   
  carts Cart[]
}


model Address {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id])

  fullName     String   // Full name of recipient
  phone        String   // Contact number
  addressLine1 String   // Primary address
  addressLine2 String?  // Optional additional info
  city         String
  state        String
  pincode      String
  country      String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]  // ✅ reverse relation from Order
}




model Category {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}


model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  sku         String?  @unique
  brand       String?
  color       String?
  price       Float
  thumbnail   String
  images      String[]
  description String?
  categoryId  String   @db.ObjectId
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @updatedAt
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)

  variantStock VariantStock[] @relation("ProductVariants") // 👈 new
  cartItems    CartItem[]     // ✅ added
  orderItems   OrderItem[]    // ✅ added

  @@index([categoryId])
}

model VariantStock {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  label      String   // e.g. "32", "1kg", "Half kg", "M", etc.
  quantity   Int      // number of units
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id], name: "ProductVariants")

  cartItems  CartItem[]     // ✅ Reverse relation from CartItem
  orderItems OrderItem[]    // ✅ Reverse relation from OrderItem
}


model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  email      String
  otp      String
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  type       String   @default("email_verification")
  meta       Json?


  @@index([email])
  @@index([otp])
  @@index([type])
}


model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @db.ObjectId
  user      User       @relation(fields: [userId], references: [id])

  items     CartItem[] // Relation to CartItem

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId

  cartId       String        @db.ObjectId
  cart         Cart          @relation(fields: [cartId], references: [id])

  productId    String        @db.ObjectId
  product      Product?       @relation(fields: [productId], references: [id])

  variantId    String?       @db.ObjectId
  variant      VariantStock? @relation(fields: [variantId], references: [id])
  variantLabel String?

  quantity     Int           @default(1)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([cartId])
  @@index([productId])
}


model Order {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  userId      String       @db.ObjectId
  user        User         @relation(fields: [userId], references: [id])

  addressId   String       @db.ObjectId
  address     Address      @relation(fields: [addressId], references: [id])

  items       OrderItem[]  // 🧾 Ordered items
  status      OrderStatus  @default(PENDING)
  paymentId   String?      // For tracking Razorpay/Stripe/UPI txn ID
  totalAmount Float
  placedAt    DateTime     @default(now())

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([addressId])
}

model OrderItem {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String        @db.ObjectId
  order      Order         @relation(fields: [orderId], references: [id])

  productId  String        @db.ObjectId
  product    Product       @relation(fields: [productId], references: [id])

  variantId  String?       @db.ObjectId
  variant    VariantStock? @relation(fields: [variantId], references: [id])

  quantity   Int
  price      Float         // Price at the time of order

  @@index([orderId])
  @@index([productId])
}
