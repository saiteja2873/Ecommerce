generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER       
  ADMIN     
  MANAGER    
}


model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String?
  email     String    @unique
  password  String?   
  image     String?   
  role      Role      @default(USER)
  phone     String?  
  provider  String?   
  emailVerified Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  // orders    Order[]     
  addresses Address[]   
}


model Address {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id])

  fullName     String   // Full name of recipient
  phone        String   // Contact number
  addressLine1 String   // Primary address
  addressLine2 String?  // Optional additional info
  city         String
  state        String
  pincode      String
  country      String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}




model Category {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}


model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  sku         String?  @unique
  brand       String?
  color       String?
  price       Float
  thumbnail   String
  images      String[]
  description String?
  categoryId  String   @db.ObjectId
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @updatedAt
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)

  variantStock VariantStock[] @relation("ProductVariants") // 👈 new

  @@index([categoryId])
}

model VariantStock {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  label      String   // e.g. "32", "1kg", "Half kg", "M", etc.
  quantity   Int      // number of units
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id], name: "ProductVariants")
}


model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  email      String
  otp      String
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  type       String   @default("email_verification")
  meta       Json?


  @@index([email])
  @@index([otp])
  @@index([type])
}
